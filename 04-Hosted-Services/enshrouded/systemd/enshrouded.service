[Unit]
Description=Enshrouded Dedicated Server via Wine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=gameserver
WorkingDirectory=/home/gameserver/enshrouded/server
Environment=SERVER_DIR=/home/gameserver/enshrouded/server
ExecStart=/home/gameserver/enshrouded/scripts/start-server.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=180
SuccessExitStatus=0 143

[Install]
WantedBy=multi-user.target
